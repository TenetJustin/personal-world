{
  "name": "personal-world",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "node scripts/prepare_pdf.mjs && vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "node --test tests/*.test.ts",
    "assets:fetch": "python3 scripts/fetch_assets.py",
    "assets:build": "node scripts/build_runtime_assets.mjs",
    "format": "prettier --write src tests scripts/*.mjs vite.config.ts",
    "assets:fetch:phase01b": "python3 scripts/fetch_assets_phase01b.py",
    "assets:phase01b": "node scripts/build_phase01b.mjs",
    "start": "npm run build && vite preview --host 127.0.0.1 --port 5177 --strictPort"
  },
  "dependencies": {
    "@react-three/fiber": "9.4.0",
    "pdfjs-dist": "6.4.299",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "three": "0.180.0"
  },
  "devDependencies": {
    "@gltf-transform/core": "4.2.1",
    "@gltf-transform/extensions": "4.2.1",
    "@gltf-transform/functions": "4.2.1",
    "@types/node": "22.18.0",
    "@types/react": "19.2.0",
    "@types/react-dom": "19.2.0",
    "@types/three": "0.180.0",
    "@vitejs/plugin-react": "5.0.3",
    "meshoptimizer": "0.25.0",
    "prettier": "3.6.2",
    "sharp": "0.35.5",
    "typescript": "5.9.2",
    "vite": "7.3.7"
  },
  "engines": {
    "node": ">=22.18.0"
  }
}
